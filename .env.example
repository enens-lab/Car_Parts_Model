# Copy to `.env` (git-ignored) and fill in. Every value is optional — the pipeline
# skips sources whose credentials are missing and tells you which ones it skipped.

# Kaggle — required for the "Car Engine Bay Images with YOLO Annotations" dataset (MIT).
# Create a token at https://www.kaggle.com/settings -> API -> "Create New Token".
KAGGLE_USERNAME=
KAGGLE_KEY=

# Roboflow Universe — required for the optional CC-BY-4.0 engine-bay extras.
# https://app.roboflow.com -> Settings -> API Keys (a free account is enough).
ROBOFLOW_API_KEY=

# Optional: GitHub token (only used by tooling that reads private reference repos).
GITHUB_API_TOKEN=
